              "id": "custom/unused-exports",
              "name": "unused-exports",
              "shortDescription": {
                "text": "1 export(s) in src/legacyCatalog.ts have no known consumers"
              }
            },
            {
              "id": "custom/unused-import",
              "name": "unused-import",
              "shortDescription": {
                "text": "Imported binding 'unusedPromotion' is not used"
              }
            }
          ]
        }
