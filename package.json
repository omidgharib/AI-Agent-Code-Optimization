{
  "name": "ai-auditor",
  "version": "1.0.0",
  "bin": {
    "ai-auditor": "./dist/cli/index.js"
  },
  "scripts": {
    "prebuild": "npm run test:architecture",
    "build": "node scripts/clean-dist.js && tsc && node -e \"const fs=require('fs');const f='dist/cli/index.js';fs.writeFileSync(f,'#!/usr/bin/env node\\n'+fs.readFileSync(f,'utf8'));fs.chmodSync(f,0o755);\"",
    "test:forgetmeai": "npm run build && node scripts/test-forgetmeai.js",
    "install:git-hook": "node scripts/install-git-hook.js",
    "build:ui": "npm --prefix ui run build",
    "build:all": "npm run build && npm run build:ui",
    "test": "jest",
    "test:architecture": "jest src/tests/e01Contracts.test.ts --runInBand",
    "test:persistence": "jest src/tests/e02Persistence.test.ts --runInBand",
    "test:security": "jest src/tests/e03Security.test.ts --runInBand",
    "security:gate": "node scripts/security-gates.js",
    "sbom": "npm sbom --sbom-format cyclonedx > sbom.cdx.json",
    "start": "node dist/cli/index.js",
    "web": "node scripts/start-web.js",
    "ui:dev": "npm --prefix ui run dev"
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "chalk": "^5.3.0",
    "chrome-launcher": "^1.1.2",
    "commander": "^12.0.0",
    "eslint": "^8.57.1",
    "execa": "^9.0.0",
    "glob": "^11.0.0",
    "ignore": "^7.0.8",
    "lighthouse": "^12.0.0",
    "zod": "^3.22.0"
  },
  "optionalDependencies": {
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}
